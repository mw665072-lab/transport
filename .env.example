# ---------------------------------------------------------------------------
# Company / demo switch
# ---------------------------------------------------------------------------
# Which company to run. This switches BOTH the on-screen branding AND the MongoDB
# database at once. The value must match a profile in src/demos/<slug>.json
# (e.g. zewar, acme). To add a company: create src/demos/<slug>.json and register
# it in src/lib/data/demos.ts. All company copy (name, phone, email, address,
# domain) comes from that JSON — no code edits per company.
#
# NEXT_PUBLIC_DEMO is read by the app (browser + server); the seed scripts also
# accept DEMO. Keep one of them set.
NEXT_PUBLIC_DEMO=demo

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
# Canonical origin for metadata, canonical tags, sitemap.xml and robots.txt.
# Optional: when unset, the active demo's own `domain` is used.
# A localhost value is ignored in production builds.
# NEXT_PUBLIC_SITE_URL=https://example.com

# ---------------------------------------------------------------------------
# Contact form email (Resend)  — server only, never exposed to the browser
# ---------------------------------------------------------------------------
# API key from https://resend.com/api-keys
RESEND_API_KEY=
# Must be an address on a domain you have verified in Resend.
CONTACT_FROM_EMAIL=Your Company <dispatch@example.com>
# Where contact submissions are delivered. Defaults to COMPANY.email.
CONTACT_TO_EMAIL=dispatch@example.com

# ---------------------------------------------------------------------------
# Database (MongoDB)
# ---------------------------------------------------------------------------
# Atlas connection string, or mongodb://127.0.0.1:27017 for local development.
#
# If a machine reports "querySrv ECONNREFUSED", its DNS cannot resolve SRV
# records. Either set that machine's DNS to 1.1.1.1, or use the non-SRV form
# Atlas offers under Connect > Drivers > "older driver version", which lists the
# shard hosts explicitly and needs no SRV lookup.
MONGODB_URI=mongodb://127.0.0.1:27017
# Database name is normally taken from the active demo (src/demos/<slug>.json →
# dbName), so leave MONGODB_DB unset. Set it only to force a specific database.
# MONGODB_DB=

# ---------------------------------------------------------------------------
# Admin panel
# ---------------------------------------------------------------------------
# Password for /admin. Required, or the panel stays disabled.
ADMIN_PASSWORD=
# Optional: separate secret for signing the admin session cookie.
# Falls back to ADMIN_PASSWORD, which invalidates sessions when the password changes.
ADMIN_SESSION_SECRET=
# Optional: salt so stored IP hashes are not reversible via a rainbow table.
IP_HASH_SALT=

# Where uploaded resumes are written. Must be on a persistent volume, and must
# NOT be inside public/ - resumes are served only through the authenticated
# /api/admin/resume/[id] route.
RESUME_UPLOAD_DIR=./data/resumes

# Where uploaded shipping documents (BOL, POD) are written. Same rules as
# resumes: persistent volume, and never inside public/.
DOCUMENT_UPLOAD_DIR=./data/documents

# ---------------------------------------------------------------------------
# Legacy: quote and owner-operator forms still post here until migrated
# ---------------------------------------------------------------------------
NEXT_PUBLIC_FORM_ENDPOINT=
