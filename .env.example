# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
# Canonical origin for metadata, canonical tags, sitemap.xml and robots.txt.
# A localhost value is ignored in production builds.
NEXT_PUBLIC_SITE_URL=https://zewartransport.com

# ---------------------------------------------------------------------------
# Contact form email (Resend)  — server only, never exposed to the browser
# ---------------------------------------------------------------------------
# API key from https://resend.com/api-keys
RESEND_API_KEY=
# Must be an address on a domain you have verified in Resend.
CONTACT_FROM_EMAIL=Zewar Transport <dispatch@zewartransport.com>
# Where contact submissions are delivered. Defaults to COMPANY.email.
CONTACT_TO_EMAIL=sam@zewartransport.com

# ---------------------------------------------------------------------------
# Database (MongoDB)
# ---------------------------------------------------------------------------
# Atlas connection string, or mongodb://localhost:27017 for local development.
MONGODB_URI=mongodb://127.0.0.1:27017
# Database name inside the cluster.
MONGODB_DB=zewar

# ---------------------------------------------------------------------------
# Admin panel
# ---------------------------------------------------------------------------
# Password for /admin. Required, or the panel stays disabled.
ADMIN_PASSWORD=
# Optional: separate secret for signing the admin session cookie.
# Falls back to ADMIN_PASSWORD, which invalidates sessions when the password changes.
ADMIN_SESSION_SECRET=
# Optional: salt so stored IP hashes are not reversible via a rainbow table.
IP_HASH_SALT=

# Where uploaded resumes are written. Must be on a persistent volume, and must
# NOT be inside public/ - resumes are served only through the authenticated
# /api/admin/resume/[id] route.
RESUME_UPLOAD_DIR=./data/resumes

# Where uploaded shipping documents (BOL, POD) are written. Same rules as
# resumes: persistent volume, and never inside public/.
DOCUMENT_UPLOAD_DIR=./data/documents

# ---------------------------------------------------------------------------
# Legacy: quote and owner-operator forms still post here until migrated
# ---------------------------------------------------------------------------
NEXT_PUBLIC_FORM_ENDPOINT=
